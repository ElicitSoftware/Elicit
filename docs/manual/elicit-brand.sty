%% elicit-brand.sty — the Elicit default brand, as LaTeX.
%%
%% Umbrella copy. It is the design every Elicit manual is typeset in (umbrella C-003: they
%% read as one set), so a change here restyles the installation manual, Admin's manual and
%% Author's two. Build all four after editing it (./buildManuals.sh), and look at
%% specimen.tex, which exercises every element below on a few pages.
%%
%% What it provides:
%%
%%   * \elicitTitlePage — the cover: the white mark on an Ink band, the title, and the
%%     version and build stamp (UC-002 BR-002). \elicitAccent tells the four covers apart.
%%   * \elicitContents — the contents page; \elicitpart — a part divider listing its chapters,
%%     and an edge tab that marks the part on every page of it.
%%   * chapters (\section) that open a page, with a hanging number and a running head.
%%   * call-outs with an icon each (elicitnote, elicitcaution, elicitsecurity), so the three
%%     are told apart in a grey-scale print too.
%%   * the elicitcmd / elicitsql / elicitfile blocks, which introduce no ligatures and no
%%     smart quotes, so a command copied out of the PDF runs as printed (umbrella NFR-007).
%%   * the settings and plain tables, for the configuration reference (FR-016, FR-017, FR-019).
%%   * \screenshot — a captured screen with rounded corners and a shadow, and the numbered
%%     step markers the capture scripts place on it.
%%   * the TikZ diagram styles (elicitdiagram, NFR-013) and \elicitProduct for the footer.
%%
%% UC-002 BR-004: the manual is typeset in the Elicit default brand regardless of which brand
%% a deployment mounts, so one document serves every site. Every \definecolor below is a color
%% of elicit-brand/colors/brand-colors.css with the same value, which checkBrand.sh holds it
%% to; every other shade in this file is a mix of them (elicitInk!8), never a new color. The
%% typefaces are the IBM Plex families brand-typography.css asks for.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{elicit-brand}[2026/11/16 Elicit default brand]

%% url must see these options before anything else loads it: without them a literal set with
%% \val, \opt or \file loses its spaces, and `openssl rand -hex 32' prints as one word.
\RequirePackage[obeyspaces, spaces]{url}
\RequirePackage[table]{xcolor}
\RequirePackage{fontspec}
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{longtable}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{fancyvrb}
\RequirePackage{etoolbox}
\RequirePackage{accsupp}
\RequirePackage{luacolor}
\RequirePackage{lua-ul}
\RequirePackage{tikz}
\usetikzlibrary{positioning, arrows.meta, calc, fit, backgrounds, shapes.geometric,
  shadows.blur, svg.path}

%% ---------------------------------------------------------------- product
%% The document sets these before \begin{document}; the footer and the cover read them.
\providecommand{\elicitProduct}{Elicit}

%% ---------------------------------------------------------------- colours
\definecolor{elicitInk}{HTML}{0A3D62}
\definecolor{elicitInkDark}{HTML}{072E4A}
\definecolor{elicitInkDarkest}{HTML}{041A2B}
\definecolor{elicitVerdigris}{HTML}{22775D}
\definecolor{elicitVerdigrisLight}{HTML}{5CBBA4}
\definecolor{elicitVerdigrisPale}{HTML}{E3F3EE}
\definecolor{elicitPaper}{HTML}{FDFCFA}
\definecolor{elicitLedger}{HTML}{E8E4DC}
\definecolor{elicitLedgerLight}{HTML}{F0EDE6}
\definecolor{elicitSlate}{HTML}{4A5A6A}
\definecolor{elicitCharcoal}{HTML}{1A2229}
\definecolor{elicitAmber}{HTML}{D9A02C}
\definecolor{elicitAmberText}{HTML}{8C6A1D}
\definecolor{elicitBrick}{HTML}{BB251B}

%% Each manual's own accent: the stripe under its cover band and its part tabs, so the four
%% covers differ on a shelf. A manual sets it with \renewcommand before \begin{document}.
\colorlet{elicitAccentColor}{elicitVerdigris}
\newcommand{\elicitAccent}[1]{\colorlet{elicitAccentColor}{#1}}

\pagecolor{elicitPaper}
\color{elicitCharcoal}

%% ---------------------------------------------------------------- typefaces
%% IBM Plex ships with TeX Live as plex-otf. The manual is typeset in it (NFR-003); a TeX
%% installation without it stops the build here rather than quietly producing a manual in
%% another typeface.
\IfFontExistsTF{IBMPlexSans}{%
  \setmainfont{IBMPlexSans}[
    UprightFont = *-Regular,
    ItalicFont = *-Italic,
    BoldFont = *-SemiBold,
    BoldItalicFont = *-SemiBoldItalic,
  ]%
  \setsansfont{IBMPlexSans}[UprightFont = *-Regular, BoldFont = *-SemiBold]%
  \newfontfamily\elicitLight{IBMPlexSans}[UprightFont = *-Light, ItalicFont = *-LightItalic,
    BoldFont = *-SemiBold, BoldItalicFont = *-SemiBoldItalic]%
}{%
  \PackageError{elicit-brand}{IBM Plex Sans is not installed}{The manuals are typeset in IBM
    Plex (NFR-003). Build them with their build-manual.sh, whose TeX Live image carries it.}%
}
\IfFontExistsTF{IBMPlexMono}{%
  %% Ligatures=NoCommon, so that a setting name or a command keeps every character it was
  %% written with (NFR-007).
  \setmonofont{IBMPlexMono}[
    UprightFont = *-Regular,
    BoldFont = *-SemiBold,
    Scale = 0.92,
    Ligatures = NoCommon,
  ]%
}{%
  \PackageError{elicit-brand}{IBM Plex Mono is not installed}{See IBM Plex Sans above.}%
}

%% ---------------------------------------------------------------- build stamp
%% UC-002 BR-002/BR-003: the version and build date appear on the title page and in every
%% footer. A build that supplies neither leaves both as "unknown" rather than omitting them.
\IfFileExists{build-info.tex}{\input{build-info.tex}}{}
\providecommand{\elicitVersion}{unknown}
\providecommand{\elicitBuildDate}{unknown}

%% ---------------------------------------------------------------- invisible to a copy
%% \elicitdecor{...} — a label, an icon or a step marker drawn on the page that must not come
%% along when a reader copies the text around it (NFR-007): it is marked as having no text.
\newcommand{\elicitdecor}[1]{\BeginAccSupp{method = plain, ActualText = {}}#1\EndAccSupp{}}

%% ---------------------------------------------------------------- the mark
%% \elicitMark{height}{rows}{selected row} — the Choice E mark, drawn from
%% elicit-brand/images/source/mark.svg so it is vector at any size and needs no image file.
\newcommand{\elicitMark}[3]{%
  \begin{tikzpicture}[x = 1pt, y = -1pt, line cap = round]
    \pgfmathsetmacro{\elicit@k}{(#1)/256pt}%
    \begin{scope}[scale = \elicit@k]
      \elicit@markrows{#2}{#3}%
    \end{scope}
  \end{tikzpicture}%
}
%% The three rows of the mark in the SVG's own units; the caller scales them.
\newcommand{\elicit@markrows}[2]{%
  \pgfmathsetlengthmacro{\elicit@u}{\elicit@k*1pt}%
  \path (0, 0) (256, 256);
  \draw[#1, line width = 12*\elicit@u] (58, 62) circle [radius = 20];
  \draw[#1, line width = 28*\elicit@u] (104, 62) -- (214, 62);
  \fill[#2] (58, 128) circle [radius = 26];
  \draw[#2, line width = 28*\elicit@u] (104, 128) -- (180, 128);
  \draw[#1, line width = 12*\elicit@u] (58, 194) circle [radius = 20];
  \draw[#1, line width = 28*\elicit@u] (104, 194) -- (214, 194);
}


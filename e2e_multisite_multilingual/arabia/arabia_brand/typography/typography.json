{
  "brand": {
    "name": "Elicit Arabia",
    "version": "1.0.0",
    "description": "Typography configuration for Elicit Arabia"
  },
  "typography": {
    "primary": {
      "name": "Arabic-first Stack",
      "family": "SF Arabic",
      "fallback": [
        "Geeza Pro",
        "Noto Naskh Arabic",
        "Noto Sans Arabic",
        "Al Bayan",
        "Segoe UI",
        "-apple-system",
        "BlinkMacSystemFont",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "weight": "normal",
      "style": "normal",
      "display": "swap"
    },
    "monospace": {
      "name": "System Monospace Stack",
      "family": "monospace",
      "fallback": [
        "SF Mono",
        "Monaco",
        "Inconsolata",
        "Roboto Mono",
        "Consolas",
        "Courier New"
      ],
      "weight": "normal",
      "style": "normal",
      "display": "swap"
    }
  },
  "styles": {
    "body": {
      "fontFamily": "SF Arabic",
      "fontSize": "16px",
      "lineHeight": "1.7"
    },
    "heading": {
      "fontFamily": "SF Arabic",
      "fontSize": "32px",
      "fontWeight": "600",
      "textAlign": "start",
      "textTransform": "none",
      "lineHeight": "1.25",
      "letterSpacing": "normal",
      "fontStyle": "normal"
    }
  }
}

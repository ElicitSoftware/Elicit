<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.elicitsoftware</groupId>
    <artifactId>e2e-multisite-multilingual</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Elicit multilingual multi-site E2E test</name>
    <description>
        Playwright journey across three running Elicit stacks (see README.md): an English master
        (USA) that imports the Census Household Survey into Author, translates it into Latin
        American Spanish and Arabic and exports the definition; a Spanish site (Mexico) and an
        Arabic site (Arabia) that apply the same file and whose respondents answer the survey in
        their own language; a reworded question that restales both translations and is retranslated
        by hand; and every remote respondent exported and imported back into the master. Reuses the
        page objects of ../e2e-tests by source (build-helper add-test-source); only tests under
        com.elicitsoftware.e2e.multilingual run here. Opt-in: mvn -DskipTests=false test, against
        stacks started with ./up.sh.
    </description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <playwright.version>1.59.0</playwright.version>
        <junit.version>6.1.1</junit.version>
        <jackson.version>2.18.2</jackson.version>
        <surefire-plugin.version>3.5.2</surefire-plugin.version>
        <build-helper-plugin.version>3.6.0</build-helper-plugin.version>
        <!-- Opt-in module: needs three live stacks. Run with -DskipTests=false. -->
        <skipTests>true</skipTests>

        <!-- Defaults match usa/, mexico/ and arabia/docker-compose.yml. -->
        <usa.survey.baseUrl>http://localhost:8080</usa.survey.baseUrl>
        <usa.admin.baseUrl>http://localhost:8081</usa.admin.baseUrl>
        <usa.author.baseUrl>http://localhost:8084</usa.author.baseUrl>
        <mexico.survey.baseUrl>http://localhost:8030</mexico.survey.baseUrl>
        <mexico.admin.baseUrl>http://localhost:8031</mexico.admin.baseUrl>
        <arabia.survey.baseUrl>http://localhost:7980</arabia.survey.baseUrl>
        <arabia.admin.baseUrl>http://localhost:7981</arabia.admin.baseUrl>
        <admin.username>admin</admin.username>
        <admin.password>admin</admin.password>
        <author.username>author</author.username>
        <author.password>author</author.password>
        <!-- The definition the master imports (UC-005). -->
        <census.definition>${project.basedir}/../samples/census-household-survey.elicit</census.definition>
        <!-- -De2e.headless=false to watch the browser. -->
        <e2e.headless>true</e2e.headless>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The hand-off translation document is JSON (Author TranslationHandoff). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper-plugin.version}</version>
                <executions>
                    <execution>
                        <id>add-e2e-page-objects</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../e2e-tests/src/test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                    <includes>
                        <include>**/multilingual/*E2ETest.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <usa.survey.baseUrl>${usa.survey.baseUrl}</usa.survey.baseUrl>
                        <usa.admin.baseUrl>${usa.admin.baseUrl}</usa.admin.baseUrl>
                        <usa.author.baseUrl>${usa.author.baseUrl}</usa.author.baseUrl>
                        <mexico.survey.baseUrl>${mexico.survey.baseUrl}</mexico.survey.baseUrl>
                        <mexico.admin.baseUrl>${mexico.admin.baseUrl}</mexico.admin.baseUrl>
                        <arabia.survey.baseUrl>${arabia.survey.baseUrl}</arabia.survey.baseUrl>
                        <arabia.admin.baseUrl>${arabia.admin.baseUrl}</arabia.admin.baseUrl>
                        <admin.username>${admin.username}</admin.username>
                        <admin.password>${admin.password}</admin.password>
                        <author.username>${author.username}</author.username>
                        <author.password>${author.password}</author.password>
                        <census.definition>${census.definition}</census.definition>
                        <e2e.headless>${e2e.headless}</e2e.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
